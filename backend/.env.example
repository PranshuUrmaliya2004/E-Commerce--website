# SMTP settings are required to send password reset emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-email@gmail.com

# Reset links should point to the deployed frontend.
FRONTEND_URL=https://shopnex-frontend.vercel.app
